generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/admin-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
}

model WebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now())
}

model Creator {
  id            String     @id @default(cuid())
  username      String     @unique
  email         String     @unique
  affiliateCode String?    @unique
  blueprints    Blueprint[]
  createdAt     DateTime   @default(now())
}

model Blueprint {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String   @db.Text
  githubUrl            String
  creatorId            String
  creator              Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  activeRuns           Int      @default(0)
  stability            Float    @default(100)
  requiredPermissions  String[] @default([])
  estimatedMonthlyCost Float    @default(0)
  tags                 String[] @default([])
  createdAt            DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  email     String
  text      String   @db.Text
  status    String   @default("PENDING")
  analysis  String?  @db.Text
  createdAt DateTime @default(now())
}

model WebTrafficMetric {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([path])
}

model PayoutRecord {
  id            String   @id @default(cuid())
  eventId       String   @unique
  revenue       Float
  platformShare Float
  creatorShare  Float
  affiliateShare Float   @default(0)
  creatorId     String
  affiliateCode String?
  createdAt     DateTime @default(now())
}
